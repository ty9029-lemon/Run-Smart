VITE_AMPLITUDE_API_KEY=
VITE_MIXPANEL_TOKEN=

# Supabase (공개 anon key. 접근 제어는 RLS가 담당한다)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버 전용 (Vercel 환경변수에 등록, VITE_ 접두어 금지)
ANTHROPIC_API_KEY=
KAKAO_REST_API_KEY=
# 공공데이터포털 "기상청_단기예보 조회서비스" 서비스키 (현재 기온 실측값)
KMA_SERVICE_KEY=
# 공공데이터포털 "한국환경공단_에어코리아_대기오염정보"·"측정소정보" 서비스키 (미세먼지 실측). 비우면 KMA_SERVICE_KEY를 쓰므로, 같은 키에 두 API 활용 신청이 되어 있어야 한다
AIRKOREA_SERVICE_KEY=
# 기상청 API허브 인증키 "AWS 매분자료" (가까운 관측소의 분 단위 실측. 인증키 값만 넣는다)
KMA_APIHUB_KEY=
